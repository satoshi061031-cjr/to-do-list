PORT=3000

# Persistent user workspace snapshots (server-side only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OAuth public base URL used for callback URLs (required in production).
# Example: https://your-domain.com
MAIL_OAUTH_BASE_URL=http://localhost:3000

# Capacitor native shell — use the same HTTPS origin as MAIL_OAUTH_BASE_URL in device builds.
# CAPACITOR_SERVER_URL=https://your-app.onrender.com

# Google OAuth
# Same client can be used for both; login only requests openid/email/profile.
# Optional dedicated sign-in client (falls back to GOOGLE_OAUTH_* if unset):
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=
# GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/mail/oauth/google/callback

# Microsoft OAuth
# Optional dedicated sign-in client (falls back to MICROSOFT_OAUTH_* if unset):
# MICROSOFT_SIGNIN_CLIENT_ID=
# MICROSOFT_SIGNIN_CLIENT_SECRET=
# MICROSOFT_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback
MICROSOFT_OAUTH_CLIENT_ID=your_microsoft_client_id
MICROSOFT_OAUTH_CLIENT_SECRET=your_microsoft_client_secret
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/mail/oauth/outlook/callback

# WeChat Open Platform website-app QR login (snsapi_login)
WECHAT_OAUTH_APP_ID=your_wechat_app_id
WECHAT_OAUTH_APP_SECRET=your_wechat_app_secret
# Optional override; defaults to ${MAIL_OAUTH_BASE_URL}/api/auth/wechat/callback
# WECHAT_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback

# Base64-encoded 32-byte key for encrypting mail tokens at rest.
# Generate: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# iCloud IMAP verification (defaults shown)
ICLOUD_IMAP_HOST=imap.mail.me.com
ICLOUD_IMAP_PORT=993
ICLOUD_IMAP_TIMEOUT_MS=12000

# Todo Agent + Mail inbox digest (defaults to Groq free tier)
GROQ_API_KEY=your_groq_api_key
# Optional overrides (Groq defaults are used if omitted):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY can also be used instead of GROQ_API_KEY
# Without a key, Mail still pulls inbox and shows snippet fallbacks (no AI digest).

# Optional critical-error webhook (POST JSON on 500s / unhandled errors).
# ALERT_WEBHOOK_URL=https://example.com/hooks/daily-space
