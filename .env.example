ALPHA_VANTAGE_API_KEY=your_key_here
SEC_USER_AGENT="DailySpaceStockSignals/1.0 your-email@example.com"
PORT=3000

# OAuth public base URL used for callback URLs (required in production).
# Example: https://your-domain.com
MAIL_OAUTH_BASE_URL=http://localhost:3000

# Google OAuth (Gmail)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# Optional override; defaults to ${MAIL_OAUTH_BASE_URL}/api/mail/oauth/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/mail/oauth/google/callback
# Optional override for sidebar user login; defaults to ${MAIL_OAUTH_BASE_URL}/api/auth/google/callback
# GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft OAuth (Outlook)
MICROSOFT_OAUTH_CLIENT_ID=your_microsoft_client_id
MICROSOFT_OAUTH_CLIENT_SECRET=your_microsoft_client_secret
# Optional override; defaults to ${MAIL_OAUTH_BASE_URL}/api/mail/oauth/outlook/callback
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/mail/oauth/outlook/callback
# Optional override for user login; defaults to ${MAIL_OAUTH_BASE_URL}/api/auth/outlook/callback
# MICROSOFT_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# Base64-encoded 32-byte key for encrypting mail tokens at rest.
# Generate: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# iCloud IMAP verification (defaults shown)
ICLOUD_IMAP_HOST=imap.mail.me.com
ICLOUD_IMAP_PORT=993
ICLOUD_IMAP_TIMEOUT_MS=12000

# Todo Agent (defaults to Groq free tier)
GROQ_API_KEY=your_groq_api_key
# Optional overrides (Groq defaults are used if omitted):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY can also be used instead of GROQ_API_KEY
