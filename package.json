{
  "name": "daily-space",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Space — quiet glass productivity for tasks, planning, calendar, mail digest, and teamwork.",
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test tests/critical-path-smoke.test.js tests/e2e-critical-path.test.js tests/global-agent.test.js tests/user-snapshot-store.test.js",
    "test:e2e": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test tests/e2e-critical-path.test.js",
    "cap:prepare": "node scripts/prepare-www.js",
    "cap:sync": "npm run cap:prepare && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/design.md": "^0.3.0",
    "@supabase/supabase-js": "^2.110.2"
  }
}
